# ── Server ────────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── PostgreSQL ─────────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stellar_urithi_bidz
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Enable SSL for production Postgres (set to "true")
POSTGRES_SSL=false

# ── Stellar ────────────────────────────────────────────────────────────────────────
# Soroban RPC endpoint
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Deployed auction contract ID (required for event indexing)
CONTRACT_ID=CD5HJY47FHBLTI5NQLUF6UM2ZYMNVG5OSCUANUME7DMVYC3FGLJWQTJV

# ── CORS ───────────────────────────────────────────────────────────────────────────
# Frontend origin for CORS (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000

# ── Indexer ────────────────────────────────────────────────────────────────────────
# How often to poll Stellar RPC for new events (ms)
POLL_INTERVAL_MS=5000
# Max events to fetch per poll batch
EVENT_BATCH_SIZE=100
# Max retries for failed RPC calls
INDEXER_MAX_RETRIES=3

# ── Rate Limiting ──────────────────────────────────────────────────────────────────
# Max requests per window (per IP)
RATE_LIMIT_MAX=100
# Window duration in ms (default: 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Optional: Redis URL for distributed rate limiting (falls back to in-memory)
# REDIS_URL=redis://localhost:6379

# ── Logging ────────────────────────────────────────────────────────────────────────
# Log level: error, warn, info, debug
LOG_LEVEL=info
