# ── Stellar Contract ──────────────────────────────────────────────────────────────
# Deployed auction contract ID on Soroban testnet
# Current deployed: CD5HJY47FHBLTI5NQLUF6UM2ZYMNVG5OSCUANUME7DMVYC3FGLJWQTJV
NEXT_PUBLIC_CONTRACT_ID=CD5HJY47FHBLTI5NQLUF6UM2ZYMNVG5OSCUANUME7DMVYC3FGLJWQTJV

# Stellar network: "testnet" or "mainnet"
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# ── Backend API ────────────────────────────────────────────────────────────────────
# Used client-side (browser → backend)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Used server-side (Next.js SSR → backend via internal Docker DNS)
# Set this to the internal backend URL in Docker, or the public URL in production
API_URL_INTERNAL=http://localhost:4000

# WebSocket endpoint for real-time bid updates
NEXT_PUBLIC_WS_URL=http://localhost:4000

# ── IPFS (Pinata) ──────────────────────────────────────────────────────────────────
# Pinata JWT for server-side IPFS uploads (API route only — NEVER exposed to client)
PINATA_JWT=

# IPFS gateway for resolving uploaded content (client-safe)
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud
